#!/usr/bin/env bash
# Lightweight wrapper to launch the Rust GTK app (terminator2).
# Repeated invocations will activate the existing instance over D-Bus
# because the app uses a unique GApplication ID and handles activation
# by opening a new window.

set -euo pipefail

HERE="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

if [ -x "$HERE/terminator2" ]; then
  exec "$HERE/terminator2" "$@"
fi

if command -v terminator2 >/dev/null 2>&1; then
  exec terminator2 "$@"
fi

echo "Error: terminator2 binary not found next to this script or in PATH." >&2
exit 1
